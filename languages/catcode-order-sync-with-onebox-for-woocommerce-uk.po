#. Plugin Name of the plugin
#: catcode-order-sync-with-onebox-for-woocommerce.php
msgid "CatCode Order Sync with OneBox for WooCommerce"
msgstr "CatCode Order Sync with OneBox for WooCommerce"

#. Plugin URI of the plugin
#: catcode-order-sync-with-onebox-for-woocommerce.php
msgid "https://catcode.com.ua/modules/onebox-sync-for-woocommerce/"
msgstr ""

#. Description of the plugin
#: catcode-order-sync-with-onebox-for-woocommerce.php
msgid "Sends WooCommerce orders to OneBox OS automatically: the order is created in the CRM right after checkout, with deduplication, retries and an event log."
msgstr "Автоматична відправка замовлень WooCommerce у OneBox OS: замовлення створюється в CRM одразу після оформлення, з дедуплікацією, повторними спробами та журналом подій."

#. Author of the plugin
#: catcode-order-sync-with-onebox-for-woocommerce.php
msgid "CatCode"
msgstr ""

#. Author URI of the plugin
#: catcode-order-sync-with-onebox-for-woocommerce.php
msgid "https://catcode.com.ua"
msgstr ""

#: catcode-order-sync-with-onebox-for-woocommerce.php:86
msgid "CatCode Order Sync with OneBox for WooCommerce requires an active WooCommerce installation."
msgstr "Для роботи CatCode Order Sync with OneBox for WooCommerce потрібен активний WooCommerce."

